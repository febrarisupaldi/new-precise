<?php

namespace App\Services\{{module}};

use App\DTOs\ExistsDTO;
use App\Repositories\{{module}}\{{name}}Repository;
use App\DTOs\{{module}}\{name}\Create{{name}}DTO;
use App\DTOs\{{module}}\{name}\Update{{name}}DTO;
use App\Exceptions\BadRequestException;
use Exception;
use Illuminate\Support\Facades\DB;

class {{name}}Service
{
    protected ${{nameLower}}Repo;

    public function __construct({{name}}Repository ${{nameLower}}Repo)
    {
        $this->{{nameLower}}Repo = ${{nameLower}}Repo;
    }

    public function all(): object
    {
        return $this->{{nameLower}}Repo->all()->get();
    }

    public function find(mixed $id): ?object
    {
        return $this->{{nameLower}}Repo->find($id)->first();
    }

    public function create(Create{{name}}DTO $dto): mixed
    {
        $id = $this->{{nameLower}}Repo->insert($dto->toArray());

        if (!$id) {
            throw new Exception('Failed to create {{name}}');
        }

        return $id;
    }

    public function update(int $id, Update{{name}}DTO $dto): void
    {
        DB::transaction(function () use ($id, $dto) {
            $exists = $this->{{nameLower}}Repo->find($id)->first();

            if (!$exists) {
                throw new BadRequestException('{{name}} not found', code: 404);
            }
            $this->{{nameLower}}Repo->setAuditSession($dto->toAuditArray());
            $success = $this->{{nameLower}}Repo->update($id, $dto->withoutAuditArray());

            if ($success === false) {
                throw new Exception('Failed to update {{name}}');
            }
        });
    }

    public function checkExist(ExistsDTO $dto): bool
    {
        return $this->{{nameLower}}Repo->exists($dto->columns, $dto->values);
    }
}
