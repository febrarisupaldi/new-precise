<?php

namespace App\Repositories\{{module}};

use App\Repositories\BaseRepository;
use App\Database\Schema\Table;

class {{name}}Repository extends BaseRepository
{
    protected Table ${{name}};

    /**
     * Bulk insert
     */
    public function insertBatch(
        array $rows
    ): bool {

        return $this->query()
            ->insert($rows);
    }
}
